# Ports
BROWSEROS_CDP_PORT=9005
BROWSEROS_SERVER_PORT=9105
BROWSEROS_EXTENSION_PORT=9305
VITE_BROWSEROS_SERVER_PORT=9105

# PannamOS browser binary
BROWSEROS_BINARY=/Applications/PannamOS.app/Contents/MacOS/PannamOS

# Telemetry (browser bundle)
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=
VITE_PUBLIC_SENTRY_DSN=

# PannamOS API URL placeholder. The invalid host prevents upstream cloud use.
VITE_PUBLIC_BROWSEROS_API=https://browseros.invalid

# Feature flags
VITE_ALPHA_FEATURES=false

# Private fork packaging placeholders. These are safe, non-secret build-time
# values used by wxt.config.ts. Leave unset to preserve upstream defaults.
# BROWSEROS_PRIVATE_EXTENSION_NAME=Assistant
# BROWSEROS_PRIVATE_EXTENSION_TOOLBAR_TITLE=Ask PannamOS
# BROWSEROS_PRIVATE_EXTENSION_UPDATE_URL=
# BROWSEROS_PRIVATE_DISABLE_UPDATE_URL=false

# GraphQL Schema Path (optional — falls back to schema/schema.graphql)
GRAPHQL_SCHEMA_PATH=

# Sentry build (source maps)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

NODE_ENV=development
